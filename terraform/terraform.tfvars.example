# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored and is
# excluded from VCS pushes, so it never lands in a pull request.

# Required. Find them with: az account show --query "{sub:id, tenant:tenantId}"
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

project_name = "synfra-app"
environment  = "dev"
location     = "eastus"

# ── Network ──────────────────────────────────────────────────────────────────
vnet_address_space = ["10.0.0.0/16"]
subnet_prefix      = "10.0.1.0/24"

# When false, a NAT gateway is created for outbound access instead.
assign_public_ip = true

app_port = 80
# Narrow this to your office/VPN range.
ingress_cidr = "0.0.0.0/0"

# Leave false and use Azure Bastion or `az serial-console connect`.
allow_ssh = false

# ── Virtual machine ──────────────────────────────────────────────────────────
# Required. Contents of your public key, e.g. `cat ~/.ssh/id_rsa.pub`.
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAA... you@example.com"

vm_size         = "Standard_B2s"
admin_username  = "azureuser"
os_disk_type    = "StandardSSD_LRS"
os_disk_size_gb = 30

# Zero means no data disk.
data_disk_size_gb = 0

tags = {
  Owner      = "platform-team"
  CostCenter = "engineering"
}
